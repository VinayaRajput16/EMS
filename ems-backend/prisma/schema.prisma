generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password_hash String
  role          String
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  events        Event[]
  issuedTickets IssuedTicket[]
  orders        Order[]
}

model Event {
  id             String         @id @default(uuid())
  title          String
  description    String?
  startDateTime  DateTime
  endDateTime    DateTime
  organizerId    String
  status         EventStatus    @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  allocationMode AllocationMode @default(MANUAL)
  organizer      User           @relation(fields: [organizerId], references: [id])
  issuedTickets  IssuedTicket[]
  orders         Order[]
  Ticket         Ticket[]
  ticketTypes    TicketType[]
  venue          Venue?

  @@index([organizerId])
  @@index([status])
}

model Venue {
  id             String         @id @default(uuid())
  name           String
  location       String
  capacity       Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  layoutConfig   Json
  layoutType     LayoutType
  eventId        String         @unique
  seats          Seat[]
  seatCategories SeatCategory[]
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model TicketType {
  id            String               @id @default(uuid())
  eventId       String
  name          String
  price         Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  issuedTickets IssuedTicket[]
  event         Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mappings      TicketTypeCategory[]

  @@index([eventId])
}

model TicketTypeCategory {
  id             String       @id @default(uuid())
  ticketTypeId   String
  seatCategoryId String
  seatCategory   SeatCategory @relation(fields: [seatCategoryId], references: [id], onDelete: Cascade)
  ticketType     TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([ticketTypeId, seatCategoryId])
  @@index([seatCategoryId])
}

model IssuedTicket {
  id           String     @id @default(uuid())
  userId       String
  ticketTypeId String
  seatId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  eventId      String?
  orderId      String?
  event        Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seat         Seat?      @relation(fields: [seatId], references: [id])
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@index([orderId])
  @@index([seatId])
}

model Order {
  id            String         @id @default(uuid())
  userId        String
  eventId       String
  status        OrderStatus    @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  issuedTickets IssuedTicket[]
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

model SeatCategory {
  id                   String               @id @default(uuid())
  name                 String
  priority             Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  venueId              String
  maxSeats             Int?
  seats                Seat[]
  venue                Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  ticketTypeCategories TicketTypeCategory[]

  @@index([venueId])
  @@index([venueId, priority])
}

model Seat {
  id            String         @id @default(uuid())
  categoryId    String
  label         String
  status        SeatStatus     @default(AVAILABLE)
  orderId       String?
  venueId       String
  issuedTickets IssuedTicket[]
  category      SeatCategory   @relation(fields: [categoryId], references: [id])
  venue         Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Ticket {
  id        String   @id
  eventId   String
  name      String
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum LayoutType {
  ROW_COLUMN
  OPEN_CROWD
  ROUND_TABLE
  GALLERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AllocationMode {
  MANUAL
  AUTOMATED
}

enum SeatStatus {
  AVAILABLE
  ALLOCATED
}
